# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android build outputs
android/app/build/
android/.gradle/
android/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties

# 签名密钥与密码（切勿提交到 GitHub）
android/app/app-release-key.jks
android/keystore.properties
*.jks

# OCR 本地资源（体积大，按需通过 scripts/download-ocr-assets.mjs 下载，不入库）
/public/ocr/lang/
/public/ocr/*.wasm
/public/ocr/*.wasm.js
